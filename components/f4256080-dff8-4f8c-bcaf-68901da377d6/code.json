{
  "mode": "classic",
  "html_code": "<div class=\"stage\">\n  <h1 class=\"title\">macOS Cursor Lab</h1>\n  <p class=\"subtitle\">Move, hover, click. Try selecting this text.</p>\n  <button class=\"test-btn\"><span>Hover & Click Me</span></button>\n</div>\n\n<div class=\"mac-pointer\" aria-hidden=\"true\">\n  <svg viewBox=\"0 0 32 32\" width=\"28\" height=\"32\">\n    <path d=\"M5.5 3.5 L5.5 24 L11 18.5 L14.5 27 L18 25.5 L14.5 17 L24 17 Z\" fill=\"#000\" stroke=\"#fff\" stroke-width=\"2\"\n      stroke-linejoin=\"round\" />\n  </svg>\n  <span class=\"ripple\"></span>\n</div>\n\n<style>\n  /* ---- base ---- */\n  html,\n  body {\n    height: 100%;\n    margin: 0\n  }\n\n  body {\n    background: #05070d;\n    color: #e6e8f0;\n    font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;\n    overflow: hidden;\n  }\n\n  .mac-pointer-active,\n  .mac-pointer-active * {\n    cursor: none !important\n  }\n\n  /* ---- center stage ---- */\n  .stage {\n    height: 100vh;\n    display: grid;\n    place-content: center;\n    text-align: center;\n    gap: 22px;\n    padding: 24px;\n    background: radial-gradient(1000px 600px at 50% 0%, #1b2140 0%, #0b0e1a 60%, #05070d 100%);\n  }\n\n  /* smooth title - only transform and opacity */\n  .title {\n    margin: 0;\n    font-size: clamp(42px, 7vw, 84px);\n    font-weight: 800;\n    letter-spacing: -.02em;\n    background: linear-gradient(90deg, #fff 20%, #a5b4fc 50%, #fff 80%);\n    background-size: 200% 100%;\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n    will-change: background-position;\n    animation: titleShine 6s linear infinite;\n  }\n\n  @keyframes titleShine {\n    to {\n      background-position: 200% 0\n    }\n  }\n\n  .subtitle {\n    margin: 0;\n    opacity: .75;\n    font-size: 18px\n  }\n\n  /* ---- test button - no blur, only transform/box-shadow ---- */\n  .test-btn {\n    --h: 252;\n    appearance: none;\n    border: 0;\n    background: transparent;\n    padding: 0;\n    justify-self: center;\n  }\n\n  .test-btn>span {\n    display: inline-flex;\n    padding: 16px 34px;\n    font-weight: 700;\n    font-size: 18px;\n    color: #fff;\n    border-radius: 16px;\n    background: linear-gradient(180deg, hsl(var(--h) 85% 66%), hsl(var(--h) 85% 52%));\n    box-shadow: 0 6px 0 hsl(var(--h) 85% 28%), 0 12px 24px rgba(0, 0, 0, .35);\n    transform: translateY(-3px);\n    transition: transform .12s, box-shadow .12s;\n    will-change: transform;\n    position: relative;\n  }\n\n  .test-btn:hover>span {\n    transform: translateY(-5px);\n    box-shadow: 0 8px 0 hsl(var(--h) 85% 28%), 0 18px 30px rgba(0, 0, 0, .4);\n  }\n\n  .test-btn:active>span {\n    transform: translateY(-1px);\n    box-shadow: 0 3px 0 hsl(var(--h) 85% 28%), 0 8px 16px rgba(0, 0, 0, .3);\n  }\n\n  /* smooth selection */\n  ::selection {\n    background: #7c3aed;\n    color: #fff\n  }\n\n  /* ---- mac pointer - 1:1, GPU only ---- */\n  .mac-pointer {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 28px;\n    height: 32px;\n    pointer-events: none;\n    z-index: 999999;\n    opacity: 0;\n    transform: translate3d(0, 0, 0);\n    will-change: transform;\n    contain: strict;\n  }\n\n  .mac-pointer svg {\n    display: block;\n    transform-origin: 3px 3px;\n    transition: transform 80ms ease-out;\n  }\n\n  .mac-pointer.is-down svg {\n    transform: scale(.88)\n  }\n\n  .mac-pointer.is-hover svg {\n    transform: scale(1.06)\n  }\n\n  .mac-pointer .ripple {\n    position: absolute;\n    left: 3px;\n    top: 3px;\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    background: rgba(0, 0, 0, .18);\n    transform: scale(0);\n    opacity: 0;\n  }\n\n  .mac-pointer.is-click .ripple {\n    animation: rip 280ms ease-out\n  }\n\n  @keyframes rip {\n    0% {\n      transform: scale(.3);\n      opacity: .5\n    }\n\n    100% {\n      transform: scale(6);\n      opacity: 0\n    }\n  }\n\n  @media (pointer:coarse) {\n    .mac-pointer {\n      display: none\n    }\n  }\n</style>\n\n<script>\n  (() => {\n  const p = document.querySelector('.mac-pointer');\n  if (!p || matchMedia('(pointer:coarse)').matches) return;\n  document.documentElement.classList.add('mac-pointer-active');\n\n  let mx = innerWidth/2, my = innerHeight/2, ticking = false;\n\n  const move = () => {\n    p.style.transform = `translate3d(${mx}px,${my}px,0)`;\n    ticking = false;\n  };\n\n  addEventListener('pointermove', e => {\n    mx = e.clientX; my = e.clientY;\n    p.style.opacity = '1';\n    if (!ticking) { ticking = true; requestAnimationFrame(move); }\n  }, {passive:true});\n\n  addEventListener('pointerleave', () => p.style.opacity = '0');\n  addEventListener('pointerdown', () => p.classList.add('is-down','is-click'));\n  addEventListener('pointerup', () => {\n    p.classList.remove('is-down');\n    setTimeout(()=>p.classList.remove('is-click'),280);\n  });\n\n  const hover = 'a,button,[role=\"button\"]';\n  addEventListener('pointerover', e => { if(e.target.closest(hover)) p.classList.add('is-hover') }, true);\n  addEventListener('pointerout', e => { if(e.target.closest(hover)) p.classList.remove('is-hover') }, true);\n})();\n</script>",
  "css_code": ".my-btn {\n  padding: 12px 24px;\n  background: linear-gradient(45deg, #FF512F 0%, #F09819 100%);\n  border: none;\n  border-radius: 8px;\n  color: white;\n  font-weight: bold;\n  font-size: 16px;\n  cursor: pointer;\n  box-shadow: 0 4px 15px rgba(240, 152, 25, 0.4);\n  transition: all 0.3s ease;\n}\n\n.my-btn:hover {\n  transform: translateY(-2px) scale(1.05);\n  box-shadow: 0 8px 25px rgba(240, 152, 25, 0.6);\n}",
  "js_code": "const btn = document.querySelector('.my-btn');\nbtn.addEventListener('click', () => {\n  btn.innerText = 'Clicked!';\n  setTimeout(() => btn.innerText = 'Hover me', 1000);\n});"
}