{
  "mode": "classic",
  "html_code": "<button class=\"btn-3d\">\n  <span>Continue</span>\n</button>\n\n<style>\n  .btn-3d {\n    --h: 245;\n    /* hue: change for brand color */\n    --s: 75%;\n    --l: 60%;\n    --bg-top: hsl(var(--h) var(--s) calc(var(--l) + 7%));\n    --bg-bottom: hsl(var(--h) var(--s) calc(var(--l) - 7%));\n    --shadow: hsl(var(--h) var(--s) calc(var(--l) - 28%));\n    --text: white;\n\n    appearance: none;\n    border: 0;\n    background: transparent;\n    padding: 0;\n    cursor: pointer;\n    border-radius: 14px;\n    font: 600 16px/1 system-ui, -apple-system, Segoe UI, Roboto, sans-serif;\n    letter-spacing: 0.2px;\n    outline-offset: 4px;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  .btn-3d>span {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 14px 26px;\n    border-radius: 14px;\n    color: var(--text);\n    background: linear-gradient(180deg, var(--bg-top), var(--bg-bottom));\n    transform: translateY(-6px);\n    box-shadow:\n      0 6px 0 var(--shadow),\n      0 10px 20px rgba(0, 0, 0, 0.18);\n    transition: transform 150ms cubic-bezier(.2, .8, .2, 1),\n      box-shadow 150ms cubic-bezier(.2, .8, .2, 1),\n      filter 150ms;\n    position: relative;\n    isolation: isolate;\n  }\n\n  /* subtle top highlight for depth */\n  .btn-3d>span::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    border-radius: inherit;\n    background: linear-gradient(180deg, rgba(255, 255, 255, 0.18), transparent 40%);\n    mix-blend-mode: screen;\n    pointer-events: none;\n  }\n\n  .btn-3d:hover>span {\n    transform: translateY(-8px);\n    box-shadow:\n      0 8px 0 var(--shadow),\n      0 14px 26px rgba(0, 0, 0, 0.22);\n    filter: brightness(1.02);\n  }\n\n  .btn-3d:active>span {\n    transform: translateY(-2px);\n    box-shadow:\n      0 2px 0 var(--shadow),\n      0 6px 12px rgba(0, 0, 0, 0.18);\n  }\n\n  .btn-3d:focus-visible>span {\n    outline: 2px solid hsl(var(--h) var(--s) 70%);\n    outline-offset: 2px;\n  }\n\n  .btn-3d:disabled {\n    cursor: not-allowed;\n    opacity: 0.6;\n  }\n\n  .btn-3d:disabled>span {\n    transform: translateY(-2px);\n    box-shadow: 0 2px 0 var(--shadow);\n  }\n\n  /* dark mode tweak */\n  @media (prefers-color-scheme: dark) {\n    .btn-3d>span {\n      box-shadow:\n        0 6px 0 var(--shadow),\n        0 10px 24px rgba(0, 0, 0, 0.5);\n    }\n  }\n</style>",
  "css_code": ".my-btn {\n  padding: 12px 24px;\n  background: linear-gradient(45deg, #FF512F 0%, #F09819 100%);\n  border: none;\n  border-radius: 8px;\n  color: white;\n  font-weight: bold;\n  font-size: 16px;\n  cursor: pointer;\n  box-shadow: 0 4px 15px rgba(240, 152, 25, 0.4);\n  transition: all 0.3s ease;\n}\n\n.my-btn:hover {\n  transform: translateY(-2px) scale(1.05);\n  box-shadow: 0 8px 25px rgba(240, 152, 25, 0.6);\n}",
  "js_code": "const btn = document.querySelector('.my-btn');\nbtn.addEventListener('click', () => {\n  btn.innerText = 'Clicked!';\n  setTimeout(() => btn.innerText = 'Hover me', 1000);\n});"
}